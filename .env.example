# Variabel lingkungan server portfolio (semua OPSIONAL).
#
# Cara pakai:
#   - Produksi : salin file ini menjadi `.env` lalu jalankan `npm start`
#                (server membacanya lewat `node --env-file-if-exists=.env`).
#   - Dev      : `npm run dev` hanya membaca env dari shell, mis.
#                `PORTFOLIO_ADMIN_TOKEN=rahasia npm run dev`.
#
# JANGAN commit file `.env` — hanya `.env.example` ini yang masuk repo.

# Port dan host server produksi (`npm start`).
# PORT=3000
# HOST=127.0.0.1

# Lokasi data runtime (database SQLite + folder uploads).
# Default: server/data
# PORTFOLIO_DATA_DIR=./server/data
# PORTFOLIO_DB_PATH=./server/data/portfolio.db

# Kredensial cadangan untuk skrip/otomasi (opsional, bukan pengganti login).
# Selama nilainya kosong, hanya akun admin di database yang bisa menulis.
# Token ini diperlakukan sebagai role admin.
# PORTFOLIO_ADMIN_TOKEN=

# Origin frontend yang boleh mengakses API dari browser (CORS).
#
# WAJIB diisi bila frontend dan backend di domain berbeda — mis. frontend di
# Vercel sementara API ada di Render/Railway. Tanpa nilai yang benar, browser
# memblokir semua respons API dan halaman publik tampil "Konten portfolio gagal
# dimuat".
#
# Bisa berupa beberapa origin dipisah koma (mis. domain produksi + preview).
# Default `*` (semua origin) aman karena autentikasi memakai header
# Authorization, bukan cookie: browser tidak mengirim kredensial otomatis.
# PORTFOLIO_CORS_ORIGIN=https://portofolio-anda.vercel.app

# ------------------------------- frontend ----------------------------------
# Dibaca Vite saat `npm run build` (BUKAN oleh server). Di Vercel, isi lewat
# Project Settings → Environment Variables, lalu redeploy.
# VITE_API_BASE=https://portfolio-api.onrender.com/api
