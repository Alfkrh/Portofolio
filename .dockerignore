# Semua yang tidak dibutuhkan image backend ikut dibuang di sini; Dockerfile
# hanya menyalin folder `backend/` yang perlu.

# Dependensi dibangun ulang di dalam image.
node_modules
backend/node_modules

# Prisma Client dibuat ulang oleh `postinstall` (prisma generate).
backend/src/generated

# Data runtime lokal: database SQLite lama, cluster PostgreSQL dev, dan file
# upload. Jangan sampai menimpa volume permanen server.
server/data
backend/.pgdata
backend/uploads

# Konfigurasi rahasia.
.env
.env.*
backend/.env

# Hasil build frontend — frontend di-deploy terpisah, bukan bagian image ini.
dist
dist-ssr

# Perkakas dan berkas lokal.
.git
.gitignore
.freebuff
.vscode
.idea
*.log
